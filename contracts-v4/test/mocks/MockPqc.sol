pragma solidity ^0.8.24;

/// @notice Signature-real mock of the pqcVerify precompile (0x0A01).
/// @dev Accepts ONLY (pk, sig, msg) triples whose keccak256(abi.encode(pk, sig, msg)) was registered. The registered
///      hashes come from test/fixtures/pqc.json, generated by script/gen-fixtures.mjs from real ML-DSA-87 signatures
///      and re-verified by script/verify-fixtures.mjs. It is NOT a "return true" mock: any mutated pk, sig or message
///      yields false, like the real precompile.
contract MockPqcVerify {
    mapping(bytes32 => bool) public accepted;

    function accept(bytes32 h) external {
        accepted[h] = true;
    }

    function pqcVerify(bytes calldata pk, bytes calldata sig, bytes calldata message) external view returns (bool) {
        return accepted[keccak256(abi.encode(pk, sig, message))];
    }
}

/// @notice Mock of the pqcKeyStatus precompile (0x0A02) with per-account configurable status.
contract MockPqcKeys {
    struct S {
        bool registered;
        uint8 algoId;
        bytes pubkey;
        bool pop;
    }

    mapping(address => S) public status;

    function set(address a, bool registered, uint8 algoId, bytes calldata pubkey, bool pop) external {
        status[a] = S(registered, algoId, pubkey, pop);
    }

    function pqcKeyStatus(address a) external view returns (bool, uint8, bytes memory, bool) {
        S storage s = status[a];
        return (s.registered, s.algoId, s.pubkey, s.pop);
    }
}

/// @notice Returns arbitrary raw bytes (or reverts) for any call. Used to feed PqcLib malformed precompile output.
contract RawMock {
    bytes public data;
    bool public doRevert;

    function set(bytes calldata d, bool r) external {
        data = d;
        doRevert = r;
    }

    fallback() external {
        bytes memory d = data;
        if (doRevert) {
            assembly {
                revert(0, 0)
            }
        }
        assembly {
            return(add(d, 32), mload(d))
        }
    }
}
